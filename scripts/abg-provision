#!/usr/bin/env python3
"""Build ms1..ms15 HTTP proxy profiles from PROXY_LOGIN/PROXY_PASSWORD."""
from __future__ import annotations

import json
import os
from pathlib import Path
import sys
from urllib.parse import quote

KEYS = ('PROXY_LOGIN', 'PROXY_PASSWORD')


def fail():
    print('{"error":"invalid_configuration"}', file=sys.stderr)
    return 1


def parse(text):
    found = {}
    for line in text.splitlines():
        stripped = line.strip()
        if not stripped or stripped.startswith('#') or '=' not in stripped:
            continue
        key, _, value = stripped.partition('=')
        key, value = key.strip(), value.strip()
        if key not in KEYS:
            continue
        if key in found:
            raise ValueError
        if len(value) >= 2 and value[0] == value[-1] and value[0] in '"\'':
            value = value[1:-1]
        if not value:
            raise ValueError
        found[key] = value
    if len(found) != 2:
        raise ValueError
    return found['PROXY_LOGIN'], found['PROXY_PASSWORD']


def body(login, password):
    user, pw = quote(login, safe=''), quote(password, safe='')
    chunks = []
    for index in range(1, 16):
        url = 'http://%s:%s@ms%d.example.net:8126' % (user, pw, index)
        chunks.append('[profile.ms%d]\nurl = %s\n' % (index, json.dumps(url)))
    return ''.join(chunks).encode()


def write(target: Path, data: bytes):
    if target.is_symlink() or target.exists():
        raise OSError
    parent = target.parent
    info = parent.stat()
    if not parent.is_dir() or info.st_uid != os.getuid():
        raise OSError
    tmp = parent / ('.abg-provision-' + os.urandom(8).hex())
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        os.write(fd, data)
        os.fchmod(fd, 0o600)
    finally:
        os.close(fd)
    try:
        os.link(tmp, target)
    finally:
        try:
            os.unlink(tmp)
        except OSError:
            pass


def main(argv=None):
    argv = sys.argv[1:] if argv is None else list(argv)
    values = {}
    while argv:
        if argv[0] in ('--source', '--output') and len(argv) > 1:
            values[argv[0][2:]] = argv[1]
            argv = argv[2:]
        else:
            return fail()
    if set(values) != {'source', 'output'}:
        return fail()
    try:
        text = Path(values['source']).read_text(encoding='utf-8')
        login, password = parse(text)
        write(Path(values['output']), body(login, password))
    except (OSError, ValueError, UnicodeError, TypeError, KeyError):
        return fail()
    print('profiles=15')
    return 0


if __name__ == '__main__':
    sys.exit(main())
